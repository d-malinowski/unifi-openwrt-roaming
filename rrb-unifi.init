#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 d-malinowski
#
# 802.11r RRB framing translator between OpenWRT hostapd and UniFi APs.
# Install as /etc/init.d/rrb-unifi, script as /usr/sbin/rrb-unifi.uc

START=99
USE_PROCD=1

VERBOSE=0			# 1 = log every translated frame
BSS_IFACES="phy0-ap0 phy1-ap0"	# hostapd BSSes using ft_iface=vft0

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/ucode /usr/sbin/rrb-unifi.uc
	procd_set_param env RRB_HOSTAPD_IF=vft1 RRB_LAN_IF=br-lan RRB_VERBOSE=$VERBOSE
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

boot() {
	# hostapd fails to start a BSS if ft_iface (vft0) did not exist yet when
	# Wi-Fi came up; reload Wi-Fi once in that case.
	(
		sleep 30
		for i in $BSS_IFACES; do
			ubus list "hostapd.$i" >/dev/null 2>&1 && continue
			logger -t rrb-unifi "hostapd.$i missing after boot, running wifi reload"
			wifi reload
			break
		done
	) &
	start "$@"
}
