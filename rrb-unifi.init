#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 d-malinowski
#
# 802.11r RRB framing translator between OpenWRT hostapd and UniFi APs.
# Install as /etc/init.d/rrb-unifi, script as /usr/sbin/rrb-unifi.uc,
# settings (optional) in /etc/config/rrb-unifi.
#
# The served BSSes, their BSSIDs and the LAN interface are derived from the
# running hostapd configs by the daemon itself; nothing here names them.

START=99
USE_PROCD=1

extra_command "check" "Show what the translator derives from the running config"

load_settings() {
	config_load rrb-unifi
	config_get_bool VERBOSE main verbose 0
	config_get FT_IF main ft_iface vft0
	config_get PEER_IF main peer_iface vft1
	config_get LAN_IF main lan_iface ''
	config_get WAIT main wait 120
	config_get_bool ROAM main roam_announce 1
}

start_service() {
	load_settings
	procd_open_instance
	procd_set_param command /usr/bin/ucode /usr/sbin/rrb-unifi.uc
	procd_set_param env RRB_FT_IF="$FT_IF" RRB_PEER_IF="$PEER_IF" \
		RRB_LAN_IF="$LAN_IF" RRB_WAIT="$WAIT" RRB_VERBOSE="$VERBOSE" \
		RRB_ROAM="$ROAM"
	# give up after 5 quick failures (config errors), see logread
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# Wireless or network changes applied with reload_config (LuCI does this) may
# change the BSSes or the LAN interface: restart to derive them again.
service_triggers() {
	procd_add_reload_trigger rrb-unifi wireless network
}

reload_service() {
	stop
	start
}

check() {
	load_settings
	RRB_CHECK=1 RRB_FT_IF="$FT_IF" RRB_PEER_IF="$PEER_IF" RRB_LAN_IF="$LAN_IF" RRB_ROAM="$ROAM" \
		/usr/bin/ucode /usr/sbin/rrb-unifi.uc
}
