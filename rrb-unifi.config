config rrb 'main'
	# 1 = log every translated frame
	option verbose '0'
	# hostapd's ft_iface (vft0) and the translator's end of the veth (vft1)
	option ft_iface 'vft0'
	option peer_iface 'vft1'
	# LAN interface for inter-AP messages; empty = derived from the hostapd
	# config (the bridge of the Wi-Fi network, e.g. br-lan)
	#option lan_iface 'br-lan'
	# seconds to wait at startup for hostapd configs using ft_iface; 0 = no
	# deadline: wait for the veth pair and for a BSS on it, however long (for
	# a system that creates them later, e.g. openUF)
	option wait '120'
	# 1 = UniFi roam announcements (UBNT_ROAM): tell UniFi APs when a client
	# arrives here, and drop a client here when a UniFi AP announces it
	option roam_announce '1'
	# record the UniFi APs heard on the LAN (BSSID, and the WLAN's mobility
	# domain once a verified roam announcement names it) as JSON in this
	# file, for whoever writes hostapd's key holders; empty = off
	#option peers_file '/var/run/rrb-unifi/peers.json'
